<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Filled in by scripts/install-login.sh: @LABEL@ from the local config (build.launchd_label), @APP@ the built app. -->
<plist version="1.0"><dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key><array><string>@APP@/Contents/MacOS/Drafter</string></array>
  <key>RunAtLoad</key><true/>
  <!-- back after a crash; Quit from the menu exits 0 and stays quit -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>20</integer>
  <key>ProcessType</key><string>Interactive</string>
</dict></plist>
